---
// Unlisted interview brief for the ASU MEE 488 senior capstone (Team 9).
// Reached only by direct link from interview-request emails. Not in the
// nav, not in any sitemap, robots noindex. Employer stays off this page.
import Layout from "../../layouts/BareLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";

const BOOK = "https://calendly.com/haliburton-ndt/asu-capstone-interview";
const FORM = "https://forms.gle/ScFGBcbNfWmfbeQu5";

const flow = [
  ["0–2 min", "Who we are", "One sentence on the project, and a check that you are comfortable with how we use what you tell us."],
  ["2–15 min", "Your story", "The six themes below, in whatever order fits. We follow your experience, not a script."],
  ["15–20 min", "Your questions", "Anything you want to know about the project, and who else you think we should talk to."],
];

const after = [
  ["We write it up", "A short summary for the course: first name, role, and the three to six things you told us that matter most."],
  ["You get a copy", "We send you the summary if you want it, and correct anything we got wrong."],
  ["That is it", "No follow-ups unless you ask for them. If the project moves forward we may ask to show you what we built."],
];

const facts = [
  ["Program", "Arizona State University — MEE 488, Mechanical Engineering Design I (senior capstone), Fall 2026."],
  ["Team", "Eight mechanical engineering seniors. Advised by ASU faculty. Contact for this interview: Dontea Haliburton."],
  ["Stage", "Problem definition. We are interviewing users and experts before we commit to any design."],
  ["Timeline", "Interviews this week and next. Concept selection follows in late September; a proof-of-concept prototype by spring 2027."],
];

const themes = [
  "The last time a landing site was refused, and what made the call.",
  "What happens to the patient, the crew, or the supplies when the aircraft cannot land.",
  "What rough or unprepared ground does to the aircraft, and what that costs.",
  "What would need to be delivered, how heavy, how fragile, and how close it has to land to be useful.",
  "What would make you distrust or refuse a system that drops a package instead of landing.",
  "Who decides to adopt equipment like this, and what they would need to see first.",
];

const team = [
  ["Hayden Wachs", "Team lead"],
  ["Dontea Haliburton", "Documentation lead · user interviews"],
  ["Jason Del Aguila", "Presentation lead · users and customers"],
  ["Jordan Strickland", "Requirements"],
  ["Alex Ignacio-Gamez", "Prototyping and test"],
  ["Toby Becker", "Benchmarking"],
  ["Chandler Brignac", "Benchmarking · users"],
  ["Davinder Singh", "Benchmarking · interviews"],
];

const notCovered = [
  "No sales pitch. There is no product. Nothing to buy, trial, or endorse.",
  "No proprietary detail needed. Procedures, incident specifics, and customer names stay with you.",
  "Your name is not published. Course write-ups use a first name and a role only, and you can ask us to leave both out.",
  "Twenty minutes, on your schedule. One or two teammates may listen in.",
];
---
<Layout
  title="Interview brief — ASU MEE 488 capstone, Team 9"
  description="Background for a 20-minute user interview on precision aerial delivery in terrain where aircraft cannot land. ASU MEE 488 senior capstone, Team 9."
  theme="asu"
>
  <div class="band" role="banner">
    <div class="shell band__row">
      <span class="band__school">Arizona State University</span>
      <span class="band__prog">Ira A. Fulton Schools of Engineering · MEE 488 Senior Design · Team 9</span>
    </div>
  </div>
  <section class="page-head shell">
    <div class="hero">
      <div class="hero__text">
        <Eyebrow number="00" label="Interview brief · unlisted" />
        <h1 class="page-head__h">Getting a package to the ground where nothing can land.</h1>
        <p class="lead page-head__lead">
          A senior engineering team at Arizona State University is studying precision aerial delivery
          for places a delivery drone cannot land and a helicopter should not: a fire line, a
          mountainside, a cave or canyon with no road in. Before we design anything we want twenty
          minutes with the people who do this work.
        </p>
        <p class="meta"><span class="cred">MEE 488 · Team 9 · Fall 2026</span></p>
      </div>
      <aside class="help" aria-labelledby="help-h">
        <p class="help__eyebrow">Two ways to help</p>
        <h2 id="help-h" class="help__h">Pick whichever costs you less time.</h2>
        <a href={BOOK} class="btn help__btn" rel="noopener">Book a 20-minute call</a>
        <p class="help__or">or</p>
        <a href={FORM} class="btn btn--ghost help__btn" rel="noopener">Answer six questions in writing</a>
        <p class="help__fine">About ten minutes. No account needed. Nothing to buy, ever.</p>
      </aside>
    </div>
  </section>

  <section class="section shell">
    <div class="grid-2">
      <header>
        <Eyebrow number="01" label="The problem" />
        <h2 class="section-h">Delivery works. Touchdown does not.</h2>
      </header>
      <div class="prose">
        <p>
          Drones can already fly a package to a set of coordinates. What they cannot do reliably is put
          it on the ground when the ground is bad: a slope, a rock field, a burned-over ridge, a rooftop
          nobody surveyed, a gust that arrives as the package comes down. In those places the package
          either cannot be released or lands where it is no use.
        </p>
        <p>
          Our working question is whether a small terrain-adaptive delivery capsule, carried by any
          aircraft and released without the aircraft landing, could close that gap. The answer depends
          on what the people who fly and work in those conditions actually need, which is why we are
          asking you before we draw anything.
        </p>
      </div>
    </div>
  </section>

  <section class="section shell">
    <Eyebrow number="02" label="What we would ask" />
    <p class="muted intro">Six themes. Your story and your judgment matter more than exact numbers.</p>
    <ol class="themes">
      {themes.map((t) => <li>{t}</li>)}
    </ol>
    <p class="themes__note">
      Rather type than talk? The same six questions are here:
      <a href={FORM} rel="noopener">answer in writing</a>. Skip any you like.
    </p>
  </section>

  <section class="section shell">
    <Eyebrow number="03" label="How the twenty minutes go" />
    <ol class="flow">
      {flow.map(([t, h, d]) => (
        <li>
          <span class="flow__time">{t}</span>
          <span class="flow__h">{h}</span>
          <span class="flow__d">{d}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="section shell">
    <div class="grid-2">
      <header>
        <Eyebrow number="04" label="What this is not" />
        <h2 class="section-h">Ground rules.</h2>
      </header>
      <ul class="bare rules">
        {notCovered.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <section class="section shell">
    <Eyebrow number="05" label="What happens after" />
    <ol class="flow flow--after">
      {after.map(([h, d]) => (
        <li>
          <span class="flow__h">{h}</span>
          <span class="flow__d">{d}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="section shell">
    <Eyebrow number="06" label="The project" />
    <dl class="dl facts">
      {facts.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="section shell">
    <Eyebrow number="07" label="Meet the team" />
    <p class="muted intro">Eight mechanical engineering seniors at Arizona State University, Fall 2026. Roles from the team charter.</p>
    <ul class="bare team">
      {team.map(([name, role]) => (
        <li>
          <span class="team__name">{name}</span>
          <span class="team__role">{role}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section shell closing">
    <Eyebrow number="08" label="Help us out" />
    <p class="closing__line">Twenty minutes on a call, or ten minutes typing. Either one moves the project.</p>
    <p class="actions">
      <a href={BOOK} class="btn" rel="noopener">Book a 20-minute call</a>
      <a href={FORM} class="btn btn--ghost" rel="noopener">Answer in writing</a>
    </p>
    <p class="muted contact">Questions first? <a href="mailto:dhalibur@asu.edu?subject=ASU%20capstone%20interview">dhalibur@asu.edu</a></p>
    <p class="muted fine">This page is unlisted and shared by direct link only. It is not indexed.</p>
  </section>
</Layout>

<style is:global>
  /* ASU theme: maroon + gold on white, Arial/Helvetica per ASU brand. No logos. */
  html[data-theme="asu"] {
    --bg: #ffffff;
    --bg-elev: #f4f4f4;
    --ink: #191919;
    --ink-muted: #5c5c5c;
    --ink-faint: #8c8c8c;
    --rule: rgba(25, 25, 25, 0.14);
    --rule-strong: rgba(25, 25, 25, 0.38);
    --accent: #8c1d40;
    --accent-ink: #5c1129;
    --gold: #ffc627;
    --font-sans: Arial, "Helvetica Neue", Helvetica, sans-serif;
    --font-mono: Arial, "Helvetica Neue", Helvetica, sans-serif;
  }
  html[data-theme="asu"] .eyebrow { font-weight: 700; letter-spacing: 0.14em; }
  html[data-theme="asu"] .cred { font-weight: 700; letter-spacing: 0.02em; }
  html[data-theme="asu"] .btn { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }
  html[data-theme="asu"] .btn:hover,
  html[data-theme="asu"] .btn:focus-visible { background: var(--gold); border-color: var(--gold); color: var(--ink); }
  html[data-theme="asu"] .btn--ghost { background: transparent; color: var(--accent); }
  html[data-theme="asu"] .btn--ghost:hover { background: transparent; color: var(--accent-ink); }
</style>

<style>
  .band { background: var(--accent); color: #fff; border-bottom: 6px solid var(--gold); }
  .band__row {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    font-size: var(--text-sm); letter-spacing: 0.04em; text-transform: uppercase;
  }
  .band__school { font-weight: 700; }
  .band__prog { opacity: 0.92; }

  .page-head { padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--space-6); }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: var(--space-6);
    align-items: start;
  }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } }
  .help {
    border: 2px solid var(--accent);
    padding: var(--space-4);
    background: var(--bg-elev);
    position: sticky; top: var(--space-4);
  }
  .help__eyebrow {
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 var(--space-2);
  }
  .help__h { font-size: var(--text-lg); line-height: 1.25; letter-spacing: -0.01em; margin: 0 0 var(--space-4); }
  .help__btn { width: 100%; justify-content: center; }
  .help__or {
    text-align: center; margin: var(--space-2) 0; color: var(--ink-muted);
    font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.14em;
  }
  .help__fine { margin: var(--space-3) 0 0; font-size: var(--text-sm); color: var(--ink-muted); }

  .themes__note { margin-top: var(--space-4); max-width: var(--measure); color: var(--ink-muted); }
  .themes__note a { color: var(--accent); font-weight: 700; }

  .flow {
    list-style: none; padding: 0; margin: var(--space-4) 0 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4);
  }
  @media (max-width: 760px) { .flow { grid-template-columns: 1fr; } }
  .flow li {
    display: flex; flex-direction: column; gap: var(--space-2);
    padding-top: var(--space-3); border-top: 4px solid var(--gold);
  }
  .flow__time { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .flow__h { font-size: var(--text-lg); font-weight: 700; letter-spacing: -0.01em; }
  .flow__d { color: var(--ink-muted); max-width: 34ch; }
  .flow--after li { border-top-color: var(--accent); }

  .contact { margin-top: var(--space-4); }
  .contact a { color: var(--accent); font-weight: 700; }
  .page-head__h { margin-top: var(--space-4); max-width: 20ch; position: relative; padding-bottom: var(--space-3); }
  .page-head__h::after {
    content: ""; position: absolute; left: 0; bottom: 0;
    width: 6rem; height: 0.5rem; background: var(--gold);
  }
  .page-head__lead { margin-top: var(--space-5); }
  .meta { margin-top: var(--space-4); color: var(--ink-muted); }

  .grid-2 {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-5) var(--space-6);
    align-items: start;
  }
  @media (max-width: 760px) { .grid-2 { grid-template-columns: 1fr; } }
  .section-h { margin-top: var(--space-4); }

  .prose { max-width: var(--measure); }
  .prose p + p { margin-top: var(--space-3); }

  .intro { margin-top: var(--space-4); }
  .themes {
    counter-reset: theme;
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    max-width: var(--measure);
    border-top: 1px solid var(--rule-strong);
  }
  .themes li {
    counter-increment: theme;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .themes li::before {
    content: counter(theme, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    padding-top: 0.3em;
  }

  .rules { display: flex; flex-direction: column; gap: var(--space-3); max-width: var(--measure); }
  .rules li { padding-left: var(--space-4); position: relative; }
  .rules li::before {
    content: "";
    position: absolute; left: 0; top: 0.55em;
    width: 0.9rem; height: 0.35rem; background: var(--gold);
  }

  .facts { margin-top: var(--space-4); }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0 var(--space-5);
    margin-top: var(--space-4);
    max-width: var(--content-max);
    border-top: 1px solid var(--rule-strong);
  }
  .team li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .team__name { font-weight: 500; letter-spacing: -0.01em; }
  .team__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .closing__line { margin-top: var(--space-4); font-size: var(--text-lg); max-width: 30ch; letter-spacing: -0.01em; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .fine { margin-top: var(--space-5); font-size: var(--text-sm); }
</style>
